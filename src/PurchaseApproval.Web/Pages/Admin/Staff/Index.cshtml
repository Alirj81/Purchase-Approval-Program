@page "/admin/staff"
@model PurchaseApproval.Web.Pages.Admin.Staff.IndexModel
@{
    ViewData["Title"] = L["Staff accounts"];
}

<section>
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <h1 class="h3 mb-0">@L["Staff accounts"]</h1>
        <a asp-page="Create" class="btn btn-primary">@L["Create staff account"]</a>
    </div>
    <p class="text-secondary">@L["Administrator and accountant accounts. Each account has exactly one role. Deactivation, role changes and resets end the holder's sessions and are recorded in the audit trail."]</p>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

    @if (Model.TemporaryPassword is not null)
    {
        <div class="alert alert-warning" role="alert">
            <strong>@L["Temporary password for {0}:", Model.TemporaryPasswordFor ?? string.Empty]</strong>
            <code class="user-select-all d-block my-2">@Model.TemporaryPassword</code>
            <div>@L["Shown once. Valid until"] <timestamp utc="@Model.TemporaryPasswordExpiresAtUtc" />. @L["The holder must choose a personal password at the next sign-in; all previous sessions are ended."]</div>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-striped align-middle table-stack">
            <thead>
                <tr>
                    <th>@L["Username"]</th>
                    <th>@L["Name"]</th>
                    <th>@L["Role"]</th>
                    <th>@L["Status"]</th>
                    <th>@L["Last sign-in"]</th>
                    <th>@L["Actions"]</th>
                </tr>
            </thead>
            <tbody>
            @foreach (var account in Model.Accounts)
            {
                var isSelf = account.Id == Model.CurrentUserId;
                <tr>
                    <td data-label="@L["Username"]"><code>@account.Username</code>@if (isSelf) { <span class="badge text-bg-light border ms-1">@L["You"]</span> }</td>
                    <td data-label="@L["Name"]" dir="auto">@account.FullName</td>
                    <td data-label="@L["Role"]">@L[Labels.Role(account.Role)]</td>
                    <td data-label="@L["Status"]">
                        <span class="badge status-badge text-bg-@(account.IsActive ? "success" : "secondary")" data-marker="@(account.IsActive ? "✓" : "✕")">@(account.IsActive ? L["Active"] : L["Deactivated"])</span>
                        @if (account.MustChangePassword)
                        {
                            <div class="small text-warning-emphasis">@L["Password setup pending"]@if (account.TemporaryCredentialExpiresAtUtc is { } expiry) { <span> · <timestamp utc="@expiry" /></span> }</div>
                        }
                    </td>
                    <td data-label="@L["Last sign-in"]"><timestamp utc="@account.LastAuthenticatedAtUtc" /></td>
                    <td data-label="@L["Actions"]">
                        @if (!isSelf)
                        {
                            <div class="d-flex flex-wrap gap-2 align-items-center">
                                @if (account.IsActive)
                                {
                                    <form method="post" asp-page-handler="Deactivate" onsubmit="return confirm(this.dataset.confirm);" data-confirm="@L["Deactivate this account? The holder is signed out immediately."]">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <button class="btn btn-sm btn-outline-warning" type="submit">@L["Deactivate"]</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Reactivate">
                                        <input type="hidden" name="id" value="@account.Id" />
                                        <button class="btn btn-sm btn-outline-success" type="submit">@L["Reactivate"]</button>
                                    </form>
                                }
                                <form method="post" asp-page-handler="ResetPassword" onsubmit="return confirm(this.dataset.confirm);" data-confirm="@L["Issue a temporary password? The current password and all sessions stop working immediately."]">
                                    <input type="hidden" name="id" value="@account.Id" />
                                    <button class="btn btn-sm btn-outline-primary" type="submit">@L["Reset password"]</button>
                                </form>
                                <form method="post" asp-page-handler="ChangeRole" class="d-flex gap-1 align-items-center" onsubmit="return confirm(this.dataset.confirm);" data-confirm="@L["Change the role? The holder must sign in again to receive the new permissions."]">
                                    <input type="hidden" name="id" value="@account.Id" />
                                    <label class="visually-hidden" for="role-@account.Id">@L["Role"]</label>
                                    <select name="role" id="role-@account.Id" class="form-select form-select-sm">
                                        @foreach (var role in PurchaseApproval.Security.AppRoles.All)
                                        {
                                            <option value="@role" selected="@(role == account.Role)">@L[Labels.Role(role)]</option>
                                        }
                                    </select>
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">@L["Change role"]</button>
                                </form>
                            </div>
                        }
                        else
                        {
                            <a asp-page="/Account/ChangePassword" class="btn btn-sm btn-outline-secondary">@L["Change password"]</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
</section>
