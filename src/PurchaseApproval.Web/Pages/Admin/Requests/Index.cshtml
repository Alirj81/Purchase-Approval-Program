@* This view renders the administrator request queue, status totals, and filters. *@
@page "/admin/requests"
@model PurchaseApproval.Web.Pages.Admin.Requests.IndexModel
@{
    ViewData["Title"] = L["Payment request review"];
}

<section aria-labelledby="request-queue-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 id="request-queue-heading" class="h3 mb-1">@L["Payment request review"]</h1>
            <p class="text-secondary mb-0">@L["Review submitted requests and record one final decision."]</p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a asp-page="Index" asp-route-status="all" asp-route-mine="true" class="btn btn-outline-primary">@L["My submitted requests"]</a>
            @if (Model.ShowingMyRequests || Model.RequesterFilterLabel is not null)
            {
                <a asp-page="Index" asp-route-status="all" class="btn btn-outline-secondary">@L["Clear requester filter"]</a>
            }
        </div>
    </div>

    @if (Model.RequesterFilterLabel is not null)
    {
        <div class="alert alert-info py-2">@L[Model.RequesterFilterLabel]</div>
    }

    <div class="row g-3 mb-4" aria-label="@L["Request totals"]">
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="pending" class="card text-decoration-none h-100 @(Model.CurrentFilter == "pending" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">@L["Pending"]</div><div class="fs-3 fw-semibold ltr-value">@Model.Counts.Pending</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="approved" class="card text-decoration-none h-100 @(Model.CurrentFilter == "approved" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">@L["Approved"]</div><div class="fs-3 fw-semibold ltr-value">@Model.Counts.Approved</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="rejected" class="card text-decoration-none h-100 @(Model.CurrentFilter == "rejected" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">@L["Rejected"]</div><div class="fs-3 fw-semibold ltr-value">@Model.Counts.Rejected</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="all" class="card text-decoration-none h-100 @(Model.CurrentFilter == "all" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">@L["All"]</div><div class="fs-3 fw-semibold ltr-value">@Model.Counts.All</div></div>
            </a>
        </div>
    </div>

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">@L["There are no requests in this queue."]</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle table-stack">
                <thead>
                    <tr>
                        <th>@L["Reference"]</th>
                        <th>@L["Requester"]</th>
                        <th>@L["Payee"]</th>
                        <th class="text-end">@L["Total (IRR)"]</th>
                        <th>@L["Decision"]</th>
                        <th>@L["Execution"]</th>
                        <th>@L["Submitted"]</th>
                        <th><span class="visually-hidden">@L["Actions"]</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td data-label="@L["Reference"]"><strong class="reference">@request.ReferenceNumber</strong></td>
                        <td data-label="@L["Requester"]">
                            <a asp-page="Index" asp-route-status="all" asp-route-requesterType="@request.RequesterType" asp-route-requesterId="@request.RequesterId" dir="auto">@request.RequesterName</a>
                            <div class="small text-secondary">@L[Labels.RequesterType(request.RequesterType)]@if (!string.IsNullOrWhiteSpace(request.Department)) { <span> · <span dir="auto">@request.Department</span></span> }</div>
                        </td>
                        <td data-label="@L["Payee"]" class="wrap-anywhere" dir="auto">@request.PayeeName</td>
                        <td data-label="@L["Total (IRR)"]" class="text-end"><span class="amount ltr-value">@request.TotalAmountRials.ToString("N0")</span></td>
                        <td data-label="@L["Decision"]">
                            <span class="badge status-badge text-bg-@(request.Status == PaymentRequestStatus.Pending ? "warning" : request.Status == PaymentRequestStatus.Approved ? "success" : "danger")" data-marker="@(request.Status == PaymentRequestStatus.Pending ? "○" : request.Status == PaymentRequestStatus.Approved ? "✓" : "✕")">@L[Labels.Status(request.Status)]</span>
                            @if (request.IsSelfApproval)
                            {
                                <div class="small text-secondary">@L["Self-approved"]</div>
                            }
                        </td>
                        <td data-label="@L["Execution"]">
                            @if (request.Execution is { } execution)
                            {
                                @L[Labels.Transfer(execution)]
                                @if (request.IsClosed)
                                {
                                    <div class="small text-secondary">@L["Closed"]</div>
                                }
                            }
                            else
                            {
                                <span class="text-secondary">—</span>
                            }
                        </td>
                        <td data-label="@L["Submitted"]"><timestamp utc="@request.SubmittedAtUtc" /></td>
                        <td data-label="@L["Actions"]"><a asp-page="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">@L["Review"]</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <partial name="_Pager" model="Model.Pager" />
    }
</section>
