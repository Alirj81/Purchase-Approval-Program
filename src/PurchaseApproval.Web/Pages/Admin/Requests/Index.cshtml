@* This view renders the administrator request queue, status totals, and filters. *@
@page "/admin/requests"
@model PurchaseApproval.Web.Pages.Admin.Requests.IndexModel
@{
    ViewData["Title"] = "Payment request review";
}

<section aria-labelledby="request-queue-heading">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
        <div>
            <h1 id="request-queue-heading" class="h3 mb-1">Payment request review</h1>
            <p class="text-secondary mb-0">Review submitted requests and record one final decision.</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-page="Index" asp-route-status="all" asp-route-mine="true" class="btn btn-outline-primary">My submitted requests</a>
            @if (Model.ShowingMyRequests || Model.RequesterFilterLabel is not null)
            {
                <a asp-page="Index" asp-route-status="all" class="btn btn-outline-secondary">Clear requester filter</a>
            }
        </div>
    </div>

    @if (Model.RequesterFilterLabel is not null)
    {
        <div class="alert alert-info py-2">@Model.RequesterFilterLabel</div>
    }

    <div class="row g-3 mb-4" aria-label="Request totals">
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="pending" class="card text-decoration-none h-100 @(Model.CurrentFilter == "pending" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">Pending</div><div class="fs-3 fw-semibold">@Model.Counts.Pending</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="approved" class="card text-decoration-none h-100 @(Model.CurrentFilter == "approved" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">Approved</div><div class="fs-3 fw-semibold">@Model.Counts.Approved</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="rejected" class="card text-decoration-none h-100 @(Model.CurrentFilter == "rejected" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">Rejected</div><div class="fs-3 fw-semibold">@Model.Counts.Rejected</div></div>
            </a>
        </div>
        <div class="col-6 col-lg-3">
            <a asp-page="Index" asp-route-status="all" class="card text-decoration-none h-100 @(Model.CurrentFilter == "all" ? "border-primary" : "")">
                <div class="card-body"><div class="text-secondary">All</div><div class="fs-3 fw-semibold">@Model.Counts.All</div></div>
            </a>
        </div>
    </div>

    @if (Model.Requests.Count == 0)
    {
        <div class="alert alert-info">There are no requests in this queue.</div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th>Reference</th>
                        <th>Requester</th>
                        <th>Payee</th>
                        <th class="text-end">Total</th>
                        <th>Status</th>
                        <th>Submitted</th>
                        <th><span class="visually-hidden">Action</span></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var request in Model.Requests)
                {
                    <tr>
                        <td><strong>@request.ReferenceNumber</strong></td>
                        <td>
                            <a asp-page="Index" asp-route-status="all" asp-route-requesterType="@request.RequesterType" asp-route-requesterId="@request.RequesterId">@request.RequesterName</a>
                            @if (!string.IsNullOrWhiteSpace(request.Department))
                            {
                                <div class="small text-secondary">@request.Department</div>
                            }
                        </td>
                        <td>@request.PayeeName</td>
                        <td class="text-end text-nowrap">@request.TotalAmountRials.ToString("N0") rials</td>
                        <td><span class="badge text-bg-@(request.Status == PurchaseApproval.Models.PaymentRequestStatus.Pending ? "warning" : request.Status == PurchaseApproval.Models.PaymentRequestStatus.Approved ? "success" : "danger")">@request.Status</span></td>
                        <td class="text-nowrap">@request.SubmittedAtUtc.ToString("u")</td>
                        <td><a asp-page="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">Review</a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</section>
