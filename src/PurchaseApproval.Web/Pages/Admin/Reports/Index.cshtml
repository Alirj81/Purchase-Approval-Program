@* Administrator-only consolidated export with explicit, reproducible local-date boundaries. *@
@page "/admin/reports"
@model PurchaseApproval.Web.Pages.Admin.Reports.IndexModel
@{
    ViewData["Title"] = L["Approved request export"];
}

<section class="mx-auto" style="max-width: 64rem" aria-labelledby="report-heading">
    <div class="mb-4">
        <h1 id="report-heading" class="h3 mb-1">@L["Approved request export"]</h1>
        <p class="text-secondary mb-0">@L["Generate one worksheet containing approved employee and administrator requests."]</p>
    </div>
    <div class="card mb-4"><div class="card-body"><dl class="row mb-0">
        <dt class="col-sm-3">@L["Date basis"]</dt><dd class="col-sm-9">@L["Approval-decision timestamp"]</dd>
        <dt class="col-sm-3">@L["Reporting timezone"]</dt><dd class="col-sm-9">@L["Exporting administrator's device timezone (IANA)"]</dd>
        <dt class="col-sm-3">@L["Displayed calendar"]</dt><dd class="col-sm-9">@L["Gregorian"]</dd>
        <dt class="col-sm-3">@L["Workbook language"]</dt><dd class="col-sm-9">@L["English, with Gregorian dates and Western digits, regardless of the interface language."]</dd>
    </dl></div></div>
    <div class="alert alert-secondary py-2">@L["Two administrators in different timezones can legitimately receive different rows for the same date. A report is defined by its date range, timezone and timestamp basis; all three are written into the workbook."]</div>

    <div asp-validation-summary="All" class="alert alert-danger" role="alert"></div>
    @if (Model.NoResultsMessage is not null) { <div class="alert alert-info">@L[Model.NoResultsMessage]</div> }

    <form method="get" asp-page-handler="Export" class="card">
        <div class="card-body">
            <h2 class="h5">@L["Select a period"]</h2>
            <p class="text-secondary">@L["Use either one date or an inclusive From/To range. Both boundaries are interpreted in the visible timezone."]</p>
            <div class="row g-3">
                <div class="col-12">
                    <label asp-for="TimeZoneId" class="form-label">@L["Reporting timezone (IANA)"] <span class="required-marker" aria-hidden="true">*</span></label>
                    <input asp-for="TimeZoneId" id="report-timezone" class="form-control ltr-value" maxlength="100" required placeholder="Europe/Berlin, UTC" dir="ltr" aria-describedby="report-timezone-help report-timezone-status" />
                    <div id="report-timezone-help" class="form-text">@L["Detected from this device when available. If detection fails, enter an IANA timezone explicitly."]</div>
                    <div id="report-timezone-status" class="form-text fw-semibold" aria-live="polite" data-ready="@L["Date boundaries will use {0}.", "{0}"]" data-missing="@L["Timezone detection failed. Enter an IANA timezone before exporting."]"></div>
                </div>
                <div class="col-md-4"><label asp-for="Date" class="form-label">@L["Single date"]</label><input asp-for="Date" type="date" class="form-control ltr-value" dir="ltr" /></div>
                <div class="col-md-4"><label asp-for="From" class="form-label">@L["From date (inclusive)"]</label><input asp-for="From" type="date" class="form-control ltr-value" dir="ltr" /></div>
                <div class="col-md-4"><label asp-for="To" class="form-label">@L["To date (inclusive)"]</label><input asp-for="To" type="date" class="form-control ltr-value" dir="ltr" /></div>
            </div>
        </div>
        <div class="card-footer"><button type="submit" class="btn btn-primary">@L["Download approved requests (Excel, English)"]</button></div>
    </form>
</section>

@section Scripts { <script src="~/js/report-timezone.js" asp-append-version="true"></script> }
