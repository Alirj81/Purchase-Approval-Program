<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Purchase Approval</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/PurchaseApproval.Web.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-white border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">Purchase Approval</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Home</a>
                        </li>
                        @if (User.IsInRole(PurchaseApproval.Security.AppRoles.Administrator))
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-page="/Admin/Employees/Index">Employees</a>
                            </li>
                        }
                    </ul>
                    <div class="d-flex gap-2">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text">@User.Identity.Name</span>
                            @if (User.HasClaim(
                                PurchaseApproval.Security.EmployeeAuthenticationDefaults.AuthenticationKindClaim,
                                PurchaseApproval.Security.EmployeeAuthenticationDefaults.AuthenticationKind))
                            {
                                <form method="post" asp-page="/EmployeeAccess/Logout">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page="/Account/Logout">
                                    <button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button>
                                </form>
                            }
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-secondary" href="/account/login">Admin sign in</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Purchase Approval Program
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
