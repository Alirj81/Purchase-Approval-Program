@page "/account/change-password"
@model PurchaseApproval.Web.Pages.Account.ChangePasswordModel
@{
    ViewData["Title"] = L["Change password"];
}

<div class="row justify-content-center">
    <div class="col-md-8 col-lg-6">
        <h1 class="h3 mb-3">@L["Change password"]</h1>
        @if (Model.Required)
        {
            <div class="alert alert-warning" role="status">
                <strong>@L["A new password is required."]</strong>
                @L["You signed in with a temporary password. Choose a personal password before using the application."]
                @if (Model.TemporaryCredentialExpiresAtUtc is { } expiry)
                {
                    <div class="small mt-1">@L["Temporary password valid until"] <timestamp utc="@expiry" /></div>
                }
            </div>
        }
        <form method="post" novalidate>
            <input type="hidden" asp-for="Required" />
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="mb-3">
                <label asp-for="Input.CurrentPassword" class="form-label">@L["Current or temporary password"] <span class="required-marker" aria-hidden="true">*</span></label>
                <input asp-for="Input.CurrentPassword" class="form-control ltr-value" dir="ltr" autocomplete="current-password" required />
                <span asp-validation-for="Input.CurrentPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.NewPassword" class="form-label">@L["New password"] <span class="required-marker" aria-hidden="true">*</span></label>
                <input asp-for="Input.NewPassword" class="form-control ltr-value" dir="ltr" autocomplete="new-password" required />
                <div class="form-text">@L["At least 12 characters with upper-case, lower-case, a digit and a symbol."]</div>
                <span asp-validation-for="Input.NewPassword" class="text-danger"></span>
            </div>
            <div class="mb-3">
                <label asp-for="Input.ConfirmPassword" class="form-label">@L["Confirm new password"] <span class="required-marker" aria-hidden="true">*</span></label>
                <input asp-for="Input.ConfirmPassword" class="form-control ltr-value" dir="ltr" autocomplete="new-password" required />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>
            <div class="form-actions d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">@L["Save new password"]</button>
            </div>
        </form>
        <form method="post" asp-page="/Account/Logout" class="mt-2">
            <button type="submit" class="btn btn-link px-0">@L["Sign out instead"]</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
