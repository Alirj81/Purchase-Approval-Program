@page "/track/{reference}/{token}"
@model PurchaseApproval.Web.Pages.TrackModel
@{
    ViewData["Title"] = L["Track payment request"];
}

<section class="mx-auto" style="max-width: 42rem">
    <h1 class="h3">@L["Payment request status"]</h1>
    @if (Model.RequestStatus is { } request)
    {
        <dl class="row">
            <dt class="col-sm-5">@L["Reference"]</dt><dd class="col-sm-7"><span class="reference">@request.ReferenceNumber</span></dd>
            <dt class="col-sm-5">@L["Decision"]</dt><dd class="col-sm-7"><strong>@L[Labels.Status(request.Status)]</strong></dd>
            @if (request.Payment is { } payment)
            {
                <dt class="col-sm-5">@L["Payment"]</dt><dd class="col-sm-7">@L[Labels.PaymentForRequester(payment)]</dd>
                @if (request.IsClosed)
                {
                    <dt class="col-sm-5">@L["Execution item"]</dt>
                    <dd class="col-sm-7">@L["Execution item closed"] <span class="small text-secondary d-block">@L["Closure is an operational state; it does not confirm that a payment succeeded."]</span></dd>
                }
            }
        </dl>
        <p class="text-secondary">@L["This page intentionally shows only the reference and status. Sign in to see your request details."]</p>
    }
</section>
