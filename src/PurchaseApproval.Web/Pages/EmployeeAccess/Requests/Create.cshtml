@page "/employee/requests/create"
@model PurchaseApproval.Web.Pages.EmployeeAccess.Requests.CreateModel
@{
    ViewData["Title"] = L["New payment request"];
    var form = new PurchaseApproval.Web.Pages.RequestFormViewModel(
        Model.Input.PayeeName,
        Model.Input.Justification,
        Model.Input.RequestedAccountOrCardNumber,
        Model.Input.Lines.Select(line => new PurchaseApproval.Web.Pages.RequestFormLine(line.Description, line.AmountRials, line.HasInvoice, line.Remarks)).ToList(),
        Model.Limits.MaximumAttachmentCount,
        Model.Limits.MaximumAttachmentBytes);
}

<div class="row justify-content-center">
    <section class="col-xl-9" aria-labelledby="request-heading">
        <h1 id="request-heading" class="h3">@L["New payment request"]</h1>
        <p>@L["Enter the payment details. The server will verify the total before saving."]</p>

        @if (Model.Requester is { } requester)
        {
            <section class="card mb-4" aria-labelledby="requester-heading">
                <div class="card-body">
                    <h2 id="requester-heading" class="h5">@L["Your details"]</h2>
                    <dl class="row mb-0">
                        <dt class="col-sm-4">@L["Full name"]</dt><dd class="col-sm-8" dir="auto">@requester.FullName</dd>
                        <dt class="col-sm-4">@L["Username"]</dt><dd class="col-sm-8"><span class="ltr-value">@requester.Username</span></dd>
                        <dt class="col-sm-4">@L["Department"]</dt><dd class="col-sm-8" dir="auto">@(requester.Department ?? L["Not provided"])</dd>
                        <dt class="col-sm-4">@L["Branch"]</dt><dd class="col-sm-8" dir="auto">@(requester.Branch ?? L["Not provided"])</dd>
                        <dt class="col-sm-4">@L["Job title"]</dt><dd class="col-sm-8" dir="auto">@(requester.JobTitle ?? L["Not provided"])</dd>
                    </dl>
                </div>
            </section>
        }

        <form method="post" enctype="multipart/form-data" asp-page="Create" id="request-form">
            <input type="hidden" asp-for="SubmissionKey" />
            <partial name="_RequestForm" model="form" />
            <div class="form-actions d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" id="submit-request" data-busy-text="@L["Submitting…"]">@L["Submit request"]</button>
                <a asp-page="/EmployeeAccess/Index" class="btn btn-outline-secondary">@L["Back to dashboard"]</a>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/payment-request.js" asp-append-version="true"></script>
}
