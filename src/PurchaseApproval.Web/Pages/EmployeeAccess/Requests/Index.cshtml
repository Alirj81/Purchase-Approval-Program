@page "/employee/requests"
@model PurchaseApproval.Web.Pages.EmployeeAccess.Requests.IndexModel
@{
    ViewData["Title"] = L["My payment requests"];
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@L["My payment requests"]</h1>
    <a asp-page="Create" class="btn btn-primary">@L["New request"]</a>
</div>
@if (Model.Requests.Count == 0)
{
    <div class="alert alert-info">@L["You have not submitted any payment requests yet."]</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle table-stack">
            <thead>
                <tr>
                    <th>@L["Reference"]</th>
                    <th>@L["Payee"]</th>
                    <th class="text-end">@L["Total (IRR)"]</th>
                    <th>@L["Decision"]</th>
                    <th>@L["Payment"]</th>
                    <th>@L["Submitted"]</th>
                    <th><span class="visually-hidden">@L["Actions"]</span></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var request in Model.Requests)
            {
                <tr>
                    <td data-label="@L["Reference"]"><span class="reference">@request.ReferenceNumber</span></td>
                    <td data-label="@L["Payee"]" class="wrap-anywhere" dir="auto">@request.PayeeName</td>
                    <td data-label="@L["Total (IRR)"]" class="text-end"><span class="amount ltr-value">@request.TotalAmountRials.ToString("N0")</span></td>
                    <td data-label="@L["Decision"]">@L[Labels.Status(request.Status)]</td>
                    <td data-label="@L["Payment"]">
                        @if (request.Payment is { } payment)
                        {
                            @L[Labels.PaymentForRequester(payment)]
                            @if (request.IsClosed)
                            {
                                <div class="small text-secondary">@L["Execution item closed"]</div>
                            }
                        }
                        else
                        {
                            <span class="text-secondary">—</span>
                        }
                    </td>
                    <td data-label="@L["Submitted"]"><timestamp utc="@request.SubmittedAtUtc" /></td>
                    <td data-label="@L["Actions"]"><a asp-page="Details" asp-route-id="@request.Id" class="btn btn-sm btn-outline-primary">@L["Details"]</a></td>
                </tr>
            }
            </tbody>
        </table>
    </div>
    <partial name="_Pager" model="Model.Pager" />
}
<a asp-page="/EmployeeAccess/Index" class="btn btn-outline-secondary">@L["Back to dashboard"]</a>
