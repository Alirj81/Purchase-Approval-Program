@page "/employee/requests/submitted/{id:int}"
@model PurchaseApproval.Web.Pages.EmployeeAccess.Requests.SubmittedModel
@{
    ViewData["Title"] = L["Request submitted"];
}

<section class="mx-auto" style="max-width: 48rem" aria-labelledby="submitted-heading">
    <div class="alert alert-success" role="status">
        <h1 id="submitted-heading" class="h4">@L["Payment request submitted"]</h1>
        <p class="mb-0">@L["Your request is pending management review."]</p>
    </div>
    @if (Model.Receipt is { } receipt)
    {
        <dl class="row">
            <dt class="col-sm-4">@L["Reference"]</dt><dd class="col-sm-8"><strong class="reference">@receipt.ReferenceNumber</strong></dd>
            <dt class="col-sm-4">@L["Total"]</dt><dd class="col-sm-8"><span class="amount ltr-value">@receipt.TotalAmountRials.ToString("N0")</span> @L["IRR"]</dd>
            <dt class="col-sm-4">@L["Decision"]</dt><dd class="col-sm-8">@L[Labels.Status(receipt.Status)]</dd>
            <dt class="col-sm-4">@L["Submitted"]</dt><dd class="col-sm-8"><timestamp utc="@receipt.SubmittedAtUtc" /></dd>
        </dl>
    }
    @if (Model.TrackingUrl is not null)
    {
        <div class="alert alert-warning">
            <h2 class="h6">@L["Save your private tracking link now"]</h2>
            <p>@L["This link contains a secret token and is shown only once. Anyone with it can see the request status."]</p>
            <input class="form-control ltr-value" value="@Model.TrackingUrl" readonly aria-label="@L["Private tracking link"]" dir="ltr" />
        </div>
    }
    <div class="d-flex flex-wrap gap-2">
        <a asp-page="Index" class="btn btn-primary">@L["View my requests"]</a>
        <a asp-page="Create" class="btn btn-outline-secondary">@L["Create another"]</a>
    </div>
</section>
