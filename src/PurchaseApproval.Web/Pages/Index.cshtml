@page
@model IndexModel
@{
    ViewData["Title"] = "Purchase Approval";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <div class="text-center mb-4">
            <h1 class="display-6">Purchase Approval</h1>
            <p class="lead">Enter your employee access key to continue.</p>
        </div>

        <form method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="mb-3">
                <label asp-for="Input.AccessKey" class="form-label"></label>
                <input asp-for="Input.AccessKey" class="form-control" autocomplete="current-password" autofocus />
                <span asp-validation-for="Input.AccessKey" class="text-danger"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100">Continue</button>
        </form>

        <div class="text-center mt-3">
            <a href="/account/login" class="text-secondary">Admin sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
