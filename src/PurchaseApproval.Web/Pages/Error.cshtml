@page
@model ErrorModel
@{
    ViewData["Title"] = L["Error"];
}

<section class="mx-auto" style="max-width: 42rem">
    @if (Model.HttpStatus == 404)
    {
        <h1 class="h3">@L["Page not found"]</h1>
        <p>@L["The address you opened does not exist or is no longer available."]</p>
    }
    else if (Model.HttpStatus is 403 or 401)
    {
        <h1 class="h3">@L["Access denied"]</h1>
        <p>@L["Your account does not have permission to perform this action."]</p>
    }
    else if (Model.HttpStatus == 429)
    {
        <h1 class="h3">@L["Too many requests"]</h1>
        <p>@L["You have sent too many requests in a short time. Wait a few minutes and try again."]</p>
    }
    else
    {
        <h1 class="h3">@L["Something went wrong"]</h1>
        <p>@L["The request could not be completed. Nothing was saved. If the problem continues, give the reference below to the administrator."]</p>
    }

    @if (Model.ShowRequestId)
    {
        <p class="small text-secondary">@L["Error reference"]: <code>@Model.RequestId</code></p>
    }
    <a asp-page="/Index" class="btn btn-outline-primary">@L["Back to start"]</a>
</section>
