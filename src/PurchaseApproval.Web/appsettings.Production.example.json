{
  "_comment": "Copy to appsettings.Production.json on the server (git-ignored) or, preferably, supply the secrets through environment variables set on the IIS application pool. Never commit real values. Keys use ':' in JSON and '__' in environment variables (ConnectionStrings__DefaultConnection).",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=purchase_approval;Username=purchase_approval_app;Password=REPLACE_WITH_DATABASE_PASSWORD;SSL Mode=Prefer"
  },
  "AllowedHosts": "purchase.example.local;purchase.example.com",
  "DataProtection": {
    "KeyDirectory": "D:\\PurchaseApproval\\keys",
    "ProtectWithDpapi": true
  },
  "ForwardedHeaders": {
    "KnownProxies": []
  },
  "Limits": {
    "DailySubmissionQuota": 10,
    "SubmissionBurstLimit": 5,
    "SubmissionBurstWindowMinutes": 10,
    "MaximumAttachmentCount": 5,
    "MaximumAttachmentBytes": 5242880,
    "AllowedAttachmentContentTypes": [ "application/pdf", "image/jpeg", "image/png" ],
    "TransactionTimeFutureToleranceMinutes": 15,
    "TemporaryCredentialLifetimeHours": 24,
    "RequireEmployeeBranch": false,
    "DefaultHistoryMonths": 3,
    "HistoryPageSize": 50,
    "LoginThrottling": {
      "FailuresPerIp": 20,
      "IpWindowMinutes": 15,
      "FailuresPerAccount": 10,
      "AccountWindowMinutes": 15
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  }
}
