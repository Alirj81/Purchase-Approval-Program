<Project Sdk="Microsoft.NET.Sdk">

  <!-- PostgreSQL-backed integration tests. They run only when PURCHASE_APPROVAL_TEST_CONNECTION
       names a disposable *_test database; otherwise every test reports as skipped (not verified). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PurchaseApproval.Web\PurchaseApproval.Web.csproj" />
  </ItemGroup>

</Project>
